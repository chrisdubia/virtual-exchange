# Resend API Key for sending emails
# Sign up at https://resend.com and get your API key
# Add this to your Vercel environment variables
RESEND_API_KEY=your_resend_api_key_here

# Supabase Configuration
# Sign up at https://supabase.com and create a project
# Get these values from Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Vite environment variables (for local development)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
